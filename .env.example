# ─── TikTok App Credentials ───────────────────────────────────────────────────
# Dari: https://developers.tiktok.com → My Apps → app kamu → App Info

TIKTOK_APP_ID=your_tiktok_app_id_here
TIKTOK_APP_SECRET=your_tiktok_app_secret_here

# URL callback yang sudah didaftarkan di TikTok Developer Portal
# Format: https://NAMA-APP-KAMU.vercel.app/api/callback
TIKTOK_REDIRECT_URI=https://hackrebel-dashboard.vercel.app/api/callback

# ─── Dashboard URL ────────────────────────────────────────────────────────────
# URL GitHub Pages dashboard kamu
DASHBOARD_URL=https://USERNAME.github.io/hackrebel-dashboard/hackrebel-dashboard.html

# ─── Cron Security ───────────────────────────────────────────────────────────
# Buat random string panjang, contoh: openssl rand -hex 32
CRON_SECRET=ganti_dengan_random_string_panjang_disini

# ─── Vercel KV ────────────────────────────────────────────────────────────────
# Diisi OTOMATIS oleh Vercel saat kamu connect KV Storage di dashboard Vercel.
# Jangan isi manual.
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
